# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cnpjota?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# API Configuration
API_RATE_LIMIT_PER_SECOND=2
CNPJ_CACHE_DAYS=15

# Encryption Key for API Keys
ENCRYPTION_KEY="your-encryption-key-32-characters-long"

# Payera API Integration
# Obtenha essas credenciais em: https://payera.com.br
PAYERA_API_URL="http://localhost:3001/api/v1"
PAYERA_API_KEY="your-payera-api-key-here"
PAYERA_WEBHOOK_SECRET="your-webhook-secret-key-here"

# ClickPay SDK
# CLICKPAY_USE_SDK=true  → usa @clickpay/sdk
# CLICKPAY_USE_SDK=false → usa API direta (padrão)
CLICKPAY_USE_SDK=false
CLICKPAY_API_KEY="your-clickpay-api-key-here"
CLICKPAY_WEBHOOK_SECRET="your-clickpay-webhook-secret-here"

# Pacotes de Créditos (valores em centavos)
# Exemplo: 1000 = R$ 10,00
CREDIT_PACK_SMALL_AMOUNT=100
CREDIT_PACK_SMALL_PRICE=1000

CREDIT_PACK_MEDIUM_AMOUNT=500
CREDIT_PACK_MEDIUM_PRICE=4500

CREDIT_PACK_LARGE_AMOUNT=1000
CREDIT_PACK_LARGE_PRICE=8000

